{
  "name": "dossier-app",
  "private": true,
  "version": "0.0.0",
  "description": "Gestor de identidades Git/GitHub/GitLab por carpeta, vía Git Credential Manager e includeIf.",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.22"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.10.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "^9.17.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.4.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@nanostores/preact": "1.1.1",
    "@octokit/auth-oauth-device": "8.0.5",
    "conf": "^16.0.0",
    "electron-log": "^5.4.4",
    "electron-menubar": "11.1.3",
    "electron-updater": "^6.8.11",
    "nanostores": "1.5.5",
    "preact": "^11.2.0",
    "simple-git": "^3.36.0",
    "zod": "4.6.7"
  }
}
