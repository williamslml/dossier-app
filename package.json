{
  "name": "dossier-app",
  "private": true,
  "version": "0.0.0",
  "description": "Gestor de identidades Git/GitHub/GitLab por carpeta, vía Git Credential Manager e includeIf.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.22"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "conf": "^16.0.0",
    "simple-git": "^3.36.0"
  }
}
